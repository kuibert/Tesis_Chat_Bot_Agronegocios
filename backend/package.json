{
  "name": "agrochat-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only --clear src/main.ts",
    "build": "tsc",
    "generate-embeddings": "ts-node scripts/generateEmbeddings.ts",
    "db:migrations:gen": "npx drizzle-kit generate",
    "db:migrations:run": "npx drizzle-kit push",
    "db:migrations:drop": "npx drizzle-kit drop"
  },
  "dependencies": {
    "@xenova/transformers": "^2.16.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^18.16.0",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  }
}
